{
  "multipart": [
    {
      "apply": {
        "model": "pghv:block/cable_segment/center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "pghv:block/cable_segment/north"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "pghv:block/cable_segment/east"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "pghv:block/cable_segment/south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "pghv:block/cable_segment/west"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "pghv:block/cable_segment/up"
      }
    }
  ]
}
